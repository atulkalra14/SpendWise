<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Mobile navigation: shown instead of the sidebar on phones (max-width 768px) -->
    <HBox class="sw-bottomnav" alignItems="Center" renderType="Bare">
        <Button class="sw-bottomnav-item" type="Transparent" icon="sap-icon://home" text="{i18n>navOverview}" press=".onNavPress">
            <customData>
                <core:CustomData key="route" value="overview"/>
                <core:CustomData key="active" value="{= ${ui>/nav} === 'overview' ? 'true' : 'false' }" writeToDom="true"/>
            </customData>
        </Button>
        <Button class="sw-bottomnav-item" type="Transparent" icon="sap-icon://money-bills" text="{i18n>navTransactions}" press=".onNavPress">
            <customData>
                <core:CustomData key="active" value="{= ${ui>/nav} === 'transactions' ? 'true' : 'false' }" writeToDom="true"/>
            </customData>
        </Button>
        <Button class="sw-bottomnav-item" type="Transparent" icon="sap-icon://target-group" text="{i18n>navBudgets}" press=".onNavPress">
            <customData>
                <core:CustomData key="active" value="{= ${ui>/nav} === 'budgets' ? 'true' : 'false' }" writeToDom="true"/>
            </customData>
        </Button>
        <Button class="sw-bottomnav-item" type="Transparent" icon="sap-icon://bar-chart" text="{i18n>navAnalysis}" press=".onNavPress">
            <customData>
                <core:CustomData key="active" value="{= ${ui>/nav} === 'analysis' ? 'true' : 'false' }" writeToDom="true"/>
            </customData>
        </Button>
        <Button class="sw-bottomnav-item" type="Transparent" icon="sap-icon://person-placeholder" text="{i18n>navProfile}" press=".onOpenProfile">
            <customData>
                <core:CustomData key="active" value="{= ${ui>/nav} === 'profile' ? 'true' : 'false' }" writeToDom="true"/>
            </customData>
        </Button>
    </HBox>
</core:FragmentDefinition>
