<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!-- Template for items bound to a list of { title, description, enabled } in the profile model -->
    <HBox class="sw-setting-row" alignItems="Center" justifyContent="SpaceBetween" renderType="Bare">
        <VBox renderType="Bare">
            <Text text="{profile>title}" class="sw-body-strong"/>
            <Text text="{profile>description}" class="sw-caption"/>
        </VBox>
        <Switch state="{profile>enabled}" class="sw-switch" tooltip="{profile>title}"/>
    </HBox>
</core:FragmentDefinition>
